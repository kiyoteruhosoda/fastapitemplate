# Settings template for local development (`docker compose up`). Use with cp .env.example .env.
# Unset entries are supplied by ${VAR:-default} in docker-compose.yml (development defaults).
#
# ⚠ **Deployment settings do not live here.** The k3s declaration (deploy-repo's
#   `k8s/<app>-<env>/20-config.yaml`; template: deploy/k8s/) is authoritative, and secrets are
#   **sealed** in `25-secrets.yaml` in the same directory (ADR-0073 §1).

# --- Mounts and ports ---
# Only front (nginx) is exposed to the host. app / db are reachable only from inside the
# Docker network. The DB has no port on the host (ADR-0071 §2).
# HOST_DATA_ROOT=./mnt
# WEB_BIND_ADDR=127.0.0.1
# WEB_HOST_PORT=8080
# DOCKER_NETWORK_NAME=fastapitemplate

# --- Images ---
# Match the tag that `make image` builds.
# WEB_IMAGE=fastapitemplate:dev
# DB_IMAGE=mariadb:10.11

# --- DB credentials (override recommended) ---
# MARIADB_ROOT_PASSWORD=strong-mariadb-root-password-here
# MARIADB_USER=web_user
# MARIADB_PASSWORD=strong-mariadb-password-here
# MARIADB_DATABASE=appdb

# --- Application ---
# Initial admin password (admin if unset; always set/change it in production)
# ADMIN_INITIAL_PASSWORD=change-me-strong
# JWT_SECRET_KEY=strong-random-secret-here
# APP_BASE_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=["https://app.example.com"]

# --- Passkeys (WebAuthn) ---
# Passkeys are bound to the RP ID (domain). Changing it makes every registered passkey
# unusable, so decide the public domain before setting it.
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGIN=https://app.example.com
# WEBAUTHN_RP_NAME=fastapitemplate

# --- SSO with an external IdP (ADR-0077 §1 / ADR-0076 §3; disabled by default) ---
# Register <APP_BASE_URL>/api/auth/sso/callback with the IdP as the redirect URI.
# OIDC_ENABLED=true
# OIDC_ISSUER=https://identity.example.com/<tenant>
# OIDC_CLIENT_ID=
# OIDC_DISPLAY_NAME=SSO
# Method is client_secret_basic or private_key_jwt. ⚠ A misspelling disables SSO entirely
# (silently falling back to the default would only yield an unexplained invalid_client from the IdP).
# OIDC_CLIENT_AUTH_METHOD=private_key_jwt
# OIDC_CLIENT_SECRET=
# For private_key_jwt. ⚠ The runtime gid must be able to traverse/read both the file and its directory
# OIDC_PRIVATE_KEY_FILE=/run/oidc/client.key
# OIDC_PRIVATE_KEY_KID=
# assay service account (periodic reconciliation; ADR-0077 §7). If empty, reconciliation does not run
# MACHINE_CLIENT_ID=
# OIDC_REDIRECT_URI=https://app.example.com/api/auth/sso/callback
# ⚠ Defaults to false. If the IdP is shared across tenants, true means "anyone with an IdP account gets in"
# OIDC_AUTO_PROVISION=false
# Required authentication strength. ⚠ **Setting it fails closed** (rejects when the returned acr does not match)
# OIDC_ACR_VALUES=["urn:assay:ac:mfa"]

# --- Local sign-in (ADR-0076 §3) ---
# false disables password and passkey sign-in, and registering local credentials.
# ⚠ If locked out, set this back to true and restart (env vars take precedence over DB settings here).
# LOCAL_LOGIN_ENABLED=true
# true requires two-factor authentication for password sign-ins (ADR-0093). One switch for the whole app.
# LOCAL_TWO_FACTOR_REQUIRED=false

# --- Local development (uv run python main.py) ---
# sqlite:///app.db is used if unset
# DATABASE_URI=sqlite:///app.db

# ── Machine endpoint (ADR-0087. ⚠ env vars only. Closed if either is empty) ──
# This app's audience (the name registered as the "audience" in assay)
# MACHINE_AUDIENCE=api://example
# Allow list. operations are the permission codes allowed (unlisted operations are refused)
# MACHINE_CLIENTS=[{"client_id": "<assay client_id>", "name": "Claude", "acts_as": "claude@example.com", "operations": ["item:view"]}]

# ── Calls from the app (Android) (ADR-0081 §1. ⚠ env vars only; cannot be changed from the admin screen) ──
# client_ids of clients whose assay access tokens are accepted (none accepted if empty)
# APP_CLIENT_IDS=["<assay public client client_id>"]
# Contents of the App Links verification file (/.well-known/assetlinks.json)
# ANDROID_APP_PACKAGE=com.nolumia.example
# ANDROID_APP_CERT_FINGERPRINTS=["AA:BB:…"]
