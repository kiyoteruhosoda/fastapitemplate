# ローカル開発（`docker compose up`）用の設定テンプレート。cp .env.example .env で使う。
# 未設定の項目は docker-compose.yml の ${VAR:-default} が供給する（開発向け既定値）。
#
# ⚠ **デプロイ先の設定はここではない。** Komodo のスタック定義（deploy-repo の
#   resources/stacks.toml。雛形は deploy/komodo/stack.toml）が正で、秘密は Komodo の
#   Variable に置く（ADR-0023）。

# --- マウント・ポート ---
# ホストへ公開するのは front（nginx）だけ。app / db へは Docker ネットワーク内部
# からのみ到達する。DB はホストにポートを持たない（ADR-0010）。
# HOST_DATA_ROOT=./mnt
# WEB_BIND_ADDR=127.0.0.1
# WEB_HOST_PORT=8080
# DOCKER_NETWORK_NAME=fastapitemplate

# --- イメージ ---
# `make image` が作るタグと合わせる。
# WEB_IMAGE=fastapitemplate:dev
# DB_IMAGE=mariadb:10.11

# --- DB 資格情報（上書き推奨） ---
# MARIADB_ROOT_PASSWORD=strong-mariadb-root-password-here
# MARIADB_USER=web_user
# MARIADB_PASSWORD=strong-mariadb-password-here
# MARIADB_DATABASE=appdb

# --- アプリケーション ---
# 初期管理者パスワード（未設定なら admin / 本番では必ず設定・変更する）
# ADMIN_INITIAL_PASSWORD=change-me-strong
# JWT_SECRET_KEY=strong-random-secret-here
# SECRET_KEY=strong-random-secret-here
# APP_BASE_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=["https://app.example.com"]

# --- パスキー（WebAuthn） ---
# パスキーは RP ID（ドメイン）に結び付く。変更すると登録済みのパスキーは
# すべて使えなくなるため、公開ドメインを決めてから設定する。
# WEBAUTHN_RP_ID=app.example.com
# WEBAUTHN_ORIGIN=https://app.example.com
# WEBAUTHN_RP_NAME=fastapitemplate

# --- ローカル開発（uv run python main.py）---
# 未設定なら sqlite:///app.db が使われる
# DATABASE_URI=sqlite:///app.db
