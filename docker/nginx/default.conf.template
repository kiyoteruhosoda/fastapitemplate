# Reverse proxy. Passes all regular requests to the app (Gunicorn + UvicornWorker).
# Add locations here if large-file delivery or caching becomes necessary.
#
# Used as an envsubst template of the official nginx image (/etc/nginx/templates/*.template).
# **Only names defined as environment variables** are substituted, so nginx variables
# such as $host and $remote_addr are left intact.
#
# ⚠ **This file is for local development (docker-compose.yml) only.** The deployed nginx
#   config lives in deploy-repo's `k8s/<app>-<env>/20-config.yaml` (a ConfigMap; template:
#   deploy/k8s/20-config.yaml) and **uses a different resolver** — CoreDNS (10.43.0.10)
#   instead of docker's embedded DNS below, with FQDN upstreams. They can't be shared, so
#   **when you fix one, fix the other** (otherwise "works locally, 502 in production").

# Docker embedded DNS. Re-resolve with valid=10s. IPv6 is unused in this environment.
# ⚠ This resolver goes together with the variable-based proxy_pass below. Reverting to an
#   upstream block makes nginx resolve once at startup and cache it, returning 502 every time
#   the app is recreated (deploy-repo docs/new-stack.md §4-3; this actually broke on 2026-08-24).
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    client_max_body_size 100m;

    location / {
        # ⚠ Go through a variable so it is resolved on every request (pairs with the resolver above).
        #    Do not include a path in the value; doing so changes the URI replacement behaviour.
        # ⚠ Resolve a stack-specific alias (${APP_WEB_ALIAS}), not a generic name like `app`.
        #    The edge network is shared across the whole host, so resolving a generic name
        #    grabs another stack's container.
        set $app_upstream http://${APP_WEB_ALIAS}:8000;
        proxy_pass $app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 30s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
